#pragma once

// =============================================================================
// HPActor Configuration — generated by CMake from hpactor_config.hpp.in
// =============================================================================
//
// This header is generated by CMake's configure_file() during the build
// configuration step. Do not edit directly; edit the .in template instead.
//
// Compile-time feature flags:
//   HPACTOR_SUPPORT_COROUTINES  - 1 if C++20 coroutine support is compiled in
//   HPACTOR_ENABLE_PROACTOR     - 1 if Proactor I/O model is enabled
//
// =============================================================================

#cmakedefine01 HPACTOR_SUPPORT_COROUTINES
#cmakedefine01 HPACTOR_ENABLE_PROACTOR

// Convenience macro for guarding coroutine-specific code
#if HPACTOR_SUPPORT_COROUTINES
#    define HPACTOR_IF_COROUTINES(...) __VA_ARGS__
#    define HPACTOR_IF_NO_COROUTINES(...)
#else
#    define HPACTOR_IF_COROUTINES(...)
#    define HPACTOR_IF_NO_COROUTINES(...) __VA_ARGS__
#endif

#cmakedefine01 HPACTOR_ENABLE_MEMORY_TRACKING
#cmakedefine01 HPACTOR_ENABLE_MEMORY_DEBUG
#cmakedefine01 HPACTOR_ENABLE_CLI
#cmakedefine01 HPACTOR_ENABLE_ACTOR_LOGGING
#cmakedefine01 HPACTOR_ENABLE_ACTOR_TRACING
